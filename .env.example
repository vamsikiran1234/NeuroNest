# ==========================================
# NeuroNest Platform Environment Configuration
# ==========================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neuronest_db
DB_USERNAME=neuronest_user
DB_PASSWORD=neuronest_secure_password
DATABASE_URL=jdbc:postgresql://localhost:5432/neuronest_db

# Security & Authentication (JWT)
# 256-bit or greater secret key for HMAC-SHA256 signature
JWT_SECRET=4c87b8f9e6d3a2b1c0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7
JWT_EXPIRATION_MS=900000
# Refresh token expiration (7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Spring AI / Google Gemini Configuration
# Leave blank or unconfigured to use deterministic offline fallback behaviors
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=15

# Client Frontend Variables
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=NeuroNest
